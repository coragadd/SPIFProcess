# Copy to .env for local runs (the app does not load .env itself; export these in your shell or use `vercel env pull`).
# On Vercel, set them under Project > Settings > Environment Variables.

SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Turso database. Leave both unset locally to use a SQLite file in ./data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional
APP_URL=
SLACK_BOT_TOKEN=
SLACK_FINANCE_CHANNEL_ID=
SLACK_COMMISSION_CHANNEL_ID=
SLACK_BOT_NAME=
